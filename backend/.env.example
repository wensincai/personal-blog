# 后端环境变量示例：复制为 backend/.env（或直接导出到环境）并填入真实值
# 所有值均为占位符，切勿把真实值提交到仓库。

# JWT 签名密钥（必须与 SSO 中心一致，生产环境务必更换为随机长字符串）
BLOG_SECRET_KEY=your-secret-key-change-in-production

# 本地登录 token 有效期（天）
BLOG_ACCESS_TOKEN_EXPIRE_DAYS=7

# 删除 SSO Cookie 时的 domain（同源部署留空）
BLOG_SSO_COOKIE_DOMAIN=localhost

# 默认管理员账号（仅首次初始化时创建，部署后请立即在后台修改密码）
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=change-me-please

# 允许跨域的前端来源（逗号分隔）
BLOG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8888

# 服务监听地址与端口
BLOG_BACKEND_HOST=0.0.0.0
BLOG_BACKEND_PORT=8889

# 数据库连接串（默认 SQLite: backend/blog.db）
# BLOG_DATABASE_URL=sqlite:///./blog.db
